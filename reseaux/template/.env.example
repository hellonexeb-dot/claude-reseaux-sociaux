# Clés de l'agent réseaux sociaux.
# Ce fichier .env reste sur ton ordinateur (il est ignoré par git).
# La commande `python agent.py github` en recopie les valeurs dans les secrets GitHub.

# Réseaux utilisés (retire ceux que tu ne veux pas)
RESEAUX_ACTIFS=linkedin,facebook,instagram

# Rythme de publication : chaque post rédigé reçoit le prochain créneau libre
# (jours séparés par des virgules, ou « aucun » pour choisir chaque date à la main)
RYTHME_JOURS=mardi,jeudi
RYTHME_HEURE=12:15
# RYTHME_DELAI_HEURES=24   temps minimum laissé pour relire avant le créneau

# --- Notion ---
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_THEMES_ID=

# --- Rédaction des textes ---
# claude (recommandé, inclus dans l'abonnement Claude Pro/Max) ou gemini (gratuit)
# (vide = claude si Claude Code est installé, sinon gemini)
TEXTES_MOTEUR=
# Jeton d'abonnement : lancer `claude setup-token` dans un terminal (valable 1 an)
CLAUDE_CODE_OAUTH_TOKEN=
# ...ou, sans abonnement, une clé API payante : ANTHROPIC_API_KEY=
# CLAUDE_MODEL=sonnet
# Gemini, en secours ou pour une option 100 % gratuite
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- Images ---
IMGBB_API_KEY=
# Générateur d'images : fal | cloudflare | pollinations
# (vide = fal si FAL_KEY est remplie, sinon cloudflare si ses clés sont remplies, sinon pollinations)
IMAGES_MOTEUR=
# fal.ai : meilleure qualité, payant (~0,04 $ l'image avec Nano Banana)
FAL_KEY=
# FAL_MODEL=fal-ai/nano-banana
# Facultatif mais recommandé (plus fiable que Pollinations, utilisé sans clé)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- LinkedIn (profil personnel) ---
# Identifiants de ton app LinkedIn (onglet Auth), pour `python agent.py linkedin`
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Rempli automatiquement par `python agent.py linkedin`
LINKEDIN_TOKEN=

# --- Meta : à remplir pour `python agent.py meta` (restent en local) ---
META_APP_ID=
META_APP_SECRET=
META_USER_TOKEN=
# Remplis automatiquement par `python agent.py meta`
META_PAGE_ID=
META_PAGE_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- Réglages ---
# MIN_IDEES=5
# IDEES_PAR_LOT=5
